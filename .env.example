# Copy to .env.local:
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (macOS/Linux)

# --- Filled defaults ---
NEXT_PUBLIC_RESUME_LINK=https://drive.google.com/file/d/1nvGjMdxME9KwWCxum-HFyYwgcD3vs124/view?usp=sharing
TZ=Asia/Kolkata
NEXT_OUTPUT_STANDALONE=false

# --- Get these from dashboards (see comments in .env.local) ---
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_YAHOO_VERIFICATION=

# --- Leave empty (unused; do not put secrets in NEXT_PUBLIC_*) ---
NEXT_PUBLIC_GITHUB_TOKEN=
NEXT_PUBLIC_VERCEL_TOKEN=
